# moomoo OpenD gateway - must be running and logged in to your moomoo
# account before the agent/dashboard start. Download OpenD from
# https://openapi.moomoo.com/moomoo-api-doc/en/quick/opend-base.html
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
# Seconds to wait for OpenD to report its account logged in on connect.
MOOMOO_CONNECT_TIMEOUT=20
# Time-in-force for stop/target orders: AUTO (GTC on REAL, DAY on paper,
# since moomoo paper rejects GTC), GTC or DAY.
MOOMOO_EXIT_TIF=AUTO
# Only needed when OpenD runs on another machine with encryption enabled:
# MOOMOO_RSA_KEY_PATH=/path/to/opend_rsa_private_key.pem

# SIMULATE (paper trading - no unlock needed) or REAL
MOOMOO_TRADING_ENV=SIMULATE

# Market this agent trades: US, HK, SG or CN.
# Paper trading is available for US, HK and CN; check moomoo's docs
# before relying on SG paper trading.
MOOMOO_TRADE_MARKET=US

# Broker entity your account is with: FUTUSG (moomoo SG), FUTUINC
# (moomoo US), FUTUSECURITIES (Futu HK), FUTUAU, FUTUCA, FUTUMY, FUTUJP
MOOMOO_SECURITY_FIRM=FUTUSG

# Optional - pin a specific account. 0/empty = auto-pick the first
# account for the trading env that is authorised for the market.
MOOMOO_ACC_ID=

# Only required when MOOMOO_TRADING_ENV=REAL - your 6-digit trade unlock
# password. Alternatively unlock manually in the OpenD GUI.
MOOMOO_TRADING_PASSWORD=

# --- Tiger Brokers (only when brokers.tiger.enabled: true) ----------------
# https://quant.itigerup.com/#developer  - pip install tigeropen
# TIGER_ID=your_tiger_id
# TIGER_ACCOUNT=your_account_id
# TIGER_PRIVATE_KEY_PATH=/path/to/your/private_key.pem
# TIGER_SANDBOX=true          # true = paper/sandbox, false = live
# TIGER_MARKET=SG             # used when brokers.tiger.market is not set
# TIGER_EXIT_TIF=GTC          # GTC or DAY for resting stop/target orders

# --- IG (EXPERIMENTAL - only when brokers.ig.enabled: true) ---------------
# https://labs.ig.com  - use a DEMO account first
# IG_API_KEY=your_api_key
# IG_USERNAME=your_username
# IG_PASSWORD=your_password
# IG_ACC_TYPE=DEMO            # DEMO or LIVE
# IG_ACC_ID=                  # optional - which account to trade
# IG_CURRENCY=USD
# IG_EXPIRY=-                 # "-" for CFDs, "DFB" for spread bets

# --- Zerodha Kite Connect (only when brokers.zerodha.enabled: true) -------
# https://developers.kite.trade - pip install kiteconnect
# Orders must come from the static IP registered on the developer dashboard.
# KITE_API_KEY=your_api_key
# KITE_API_SECRET=your_api_secret
# KITE_ACCESS_TOKEN=          # normally left empty: `python kite_login.py` saves it daily
# KITE_PRODUCT=CNC            # CNC = delivery (swing)
# KITE_EXIT_MODE=gtt          # gtt (default) or order
# KITE_STOP_LIMIT_PCT=0.5     # GTT stop: limit this % beyond the trigger
# KITE_MARKET_PROTECTION=-1   # -1 = automatic; mandatory for MARKET / SL-M orders

# --- Angel One SmartAPI (only when brokers.angel.enabled: true) -----------
# https://smartapi.angelone.in - pip install smartapi-python pyotp
# Orders must come from the static IP registered in the SmartAPI dashboard.
# ANGEL_API_KEY=your_api_key
# ANGEL_CLIENT_CODE=your_client_code
# ANGEL_MPIN=your_mpin
# ANGEL_TOTP_SECRET=your_totp_secret   # the base32 secret behind your authenticator QR
# ANGEL_PRODUCT=DELIVERY
# ANGEL_LIMIT_PCT=0.5         # buffer for marketable limit orders (no MARKET orders for algos)

# Telegram reporting bot (messages are tagged [broker] when several run)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# Dashboard login token. Optional - if unset, one is generated into
# data/.dashboard_token on first start.
# DASHBOARD_TOKEN=
